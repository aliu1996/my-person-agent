# 环境标识 (dev / prod)
ENV=dev

# 数据与存储
DATABASE_URL=postgresql+asyncpg://pa:pa_dev@127.0.0.1:5432/personal_assistant
REDIS_URL=redis://127.0.0.1:6379/0
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pa-assets
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1

# 网关与内部服务地址
HIGRESS_GATEWAY_URL=http://127.0.0.1:8080
HIGRESS_CONSOLE_URL=http://127.0.0.1:8001
HIGRESS_CONSOLE_USERNAME=
HIGRESS_CONSOLE_PASSWORD=
HIGRESS_GATEWAY_CONSUMER=
HIGRESS_GATEWAY_KEY=
CHAT_API_URL=http://127.0.0.1:8100
CHAT_STREAM_URL=http://127.0.0.1:8101
SEARCH_SERVICE_URL=http://127.0.0.1:8102
DSH_BRIDGE_URL=http://127.0.0.1:8103
DSH_BRIDGE_URLS=
DSH_ENGINE=gateway
DSH_BIN=
DSH_SDK_MODULE=
SANDBOX_URL=http://127.0.0.1:8104
SANDBOX_IMAGE=pa-sandbox:phase4
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
BOCHA_API_KEY=
TAVILY_API_KEY=
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT_FILE=

# 安全密钥（本地占位，生产必须替换为高强度随机值）
USER_JWT_SECRET=dev-user-secret-change-me-at-least-32b
ADMIN_JWT_SECRET=dev-admin-secret-change-me-at-least-32b
KEY_ENCRYPT_MASTER=dev-32bytes-aes-key-placeholder1
INTERNAL_API_TOKEN=dev-internal-token-change-me

# 手机号和验证码。生产环境配置 HTTPS 短信适配服务和独立 HMAC 密钥
PHONE_HASH_SECRET=dev-phone-hmac-secret-change-me
OTP_DEV_CODE=123456
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SHARE_REPORT_THRESHOLD=3

# 初始管理员（Phase 1 Seed 使用）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=Admin@2026!ChangeMe
