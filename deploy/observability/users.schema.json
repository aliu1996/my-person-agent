{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stream load-test seed users",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["sessionId", "jwt"],
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "minLength": 1,
        "description": "A unique chat session for one virtual user"
      },
      "jwt": {
        "type": "string",
        "minLength": 1,
        "description": "User JWT for that session. Use seeded test accounts, never production tokens."
      }
    }
  }
}
